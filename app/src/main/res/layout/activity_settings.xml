<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- ADB 授权自动点击（无障碍，覆盖 Android<11 / 经典网络 ADB 弹窗） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adb_auto_click_section"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAdbAutoClick"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/adb_auto_click_btn_off"
            android:textColor="@color/text_btn_secondary"
            android:textSize="16sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/swEnableNetAdb" />

        <!-- 网络 ADB 开关：按配置地址端口自持开启 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adb_net_adb_section"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_net_adb_switch"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/swEnableNetAdb"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/btnAdbAutoClick"
                android:nextFocusDown="@id/etAdbHost" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_adb_host"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAdbHost"
            android:layout_width="300dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/swEnableNetAdb"
            android:nextFocusDown="@id/etAdbPort" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_adb_port"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAdbPort"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="number"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="24dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/etAdbHost"
            android:nextFocusDown="@id/rbModeAuto" />

        <!-- Runtime Mode -->

        <!-- Runtime Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_runtime_mode"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgRuntimeMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbModeAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/runtime_mode_auto"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/etAdbPort" />

            <RadioButton
                android:id="@+id/rbModeRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/runtime_mode_root"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <RadioButton
                android:id="@+id/rbModeProot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/runtime_mode_proot"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </RadioGroup>

        <!-- Ubuntu Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_ubuntu_version"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgUbuntuVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbUbuntu22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubuntu 22.04"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/rbArchAuto"
                android:nextFocusRight="@id/rbUbuntu24" />

            <RadioButton
                android:id="@+id/rbUbuntu24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Ubuntu 24.04"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/rbArchAuto"
                android:nextFocusLeft="@id/rbUbuntu22"
                android:nextFocusRight="@id/rbUbuntu26" />

            <RadioButton
                android:id="@+id/rbUbuntu26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Ubuntu 26.04"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/rbArchAuto"
                android:nextFocusLeft="@id/rbUbuntu24" />
        </RadioGroup>

        <!-- CPU Architecture -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_arch"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgArch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbArchAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动（推荐）"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/rbUbuntu26"
                android:nextFocusDown="@id/rbArchAmd64" />

            <RadioButton
                android:id="@+id/rbArchAmd64"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="amd64（x86_64 64位）"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/rbArchAuto"
                android:nextFocusDown="@id/rbArchArm64" />

            <RadioButton
                android:id="@+id/rbArchArm64"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="arm64（ARM 64位）"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/rbArchAmd64"
                android:nextFocusDown="@id/rbArchArmhf" />

            <RadioButton
                android:id="@+id/rbArchArmhf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="armhf（ARM 32位）"
                android:textColor="@color/text_radio"
                android:textSize="16sp"
                android:buttonTint="@color/radio_button_tint"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/rbArchArm64"
                android:nextFocusDown="@id/swAutoStart" />
        </RadioGroup>

        <!-- Auto Start -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_auto_start"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/swAutoStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_option"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/rbArchArmhf"
                android:nextFocusDown="@id/etStartScript" />
        </LinearLayout>

        <!-- Start Script Path -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_start_script"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etStartScript"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/swAutoStart"
            android:nextFocusDown="@id/etStopScript" />

        <!-- Stop Script Path -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_stop_script"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etStopScript"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/etStartScript"
            android:nextFocusDown="@id/etSshPort" />

        <!-- SSH Port -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_ssh_port"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etSshPort"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="number"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/etStopScript"
            android:nextFocusDown="@id/etSshUser" />

        <!-- Proot SSH Port -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_proot_ssh_port"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etProotSshPort"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="number"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/etSshPort"
            android:nextFocusDown="@id/etSshUser" />

        <!-- SSH Username -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_ssh_user"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etSshUser"
            android:layout_width="300dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/etSshPort"
            android:nextFocusDown="@id/etSshPassword" />

        <!-- SSH Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_ssh_password"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etSshPassword"
            android:layout_width="300dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"
            android:nextFocusUp="@id/etSshUser"
            android:nextFocusDown="@id/btnSave" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_btn_secondary"
                android:textSize="16sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/etSshPassword"
                android:nextFocusRight="@id/btnSave" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/btn_start"
                android:text="@string/btn_save"
                android:textColor="@color/text_btn_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/etSshPassword"
                android:nextFocusLeft="@id/btnCancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
